# Parth OS — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_WEBHOOK_SECRET=some-random-string
# Your personal Telegram chat id (the bot only talks to this id). Filled after first message.
ALLOWED_CHAT_ID=

# --- Gemini (the brain) ---
GEMINI_API_KEY=AQ.xxx
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase ---
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_or_service_role_jwt
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Misc ---
CRON_SECRET=some-random-string
ASSISTANT_TZ=Asia/Kolkata
